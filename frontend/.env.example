NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Optional: the URL the Next.js *server* uses to reach the API.
# Production (Vercel): NEXT_PUBLIC_API_URL=/api/v1 and API_INTERNAL_URL=https://<api>.onrender.com/api/v1.
# The site then passes /api/v1/* through to the API, so the browser only talks to one site.
# API_INTERNAL_URL=http://backend:8000/api/v1

# Production: where uploaded images are served from (the storage bucket's origin), for the CSP
# NEXT_PUBLIC_MEDIA_ORIGIN=https://<account-id>.r2.cloudflarestorage.com

# Shared with the backend (REVALIDATE_SECRET) for instant refresh after admin edits
# REVALIDATE_SECRET=replace-with-a-long-random-string

# The public address of the website (sitemap, canonical links, social previews)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
