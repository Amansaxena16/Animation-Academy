DJANGO_SECRET_KEY=replace-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://aa_user:change-me@localhost:5432/animation_academy

# Frontend origins allowed to call the API with cookies
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Refresh-token cookie. Secure defaults to on when DEBUG is off. No domain is needed in
# production: the website passes /api/v1 through to the API, so the cookie is the website's own.
# REFRESH_COOKIE_SECURE=True

# Production only (config.settings.prod)
# CSRF_TRUSTED_ORIGINS=https://animationacademy.in

# Public website address, printed on certificates as the verification link
# PUBLIC_SITE_URL=https://animationacademy.in

# Instant website refresh after admin edits (same secret in frontend/.env.local)
# FRONTEND_REVALIDATE_URL=http://localhost:3000/api/revalidate
# REVALIDATE_SECRET=replace-with-a-long-random-string

# Production uploads bucket (config.settings.prod), e.g. Cloudflare R2. Without it, uploads go
# to the local disk, which Render wipes on every deploy.
# S3_BUCKET=animation-academy-media
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Production rate limits: how many proxies sit in front of the API (see DEPLOY.md)
# TRUSTED_PROXY_COUNT=

# Production email (config.settings.prod)
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Animation Academy <info@animationacademy.in>
